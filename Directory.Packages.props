<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="bunit" Version="2.*" />
    <PackageVersion Include="coverlet.collector" Version="10.*" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageVersion Include="NSubstitute" Version="6.*" />
    <PackageVersion Include="ScissorHands.Plugin" Version="1.*-*" />
    <PackageVersion Include="Shouldly" Version="4.*" />
    <PackageVersion Include="xunit.v3" Version="4.*" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.*" />
  </ItemGroup>
</Project>
