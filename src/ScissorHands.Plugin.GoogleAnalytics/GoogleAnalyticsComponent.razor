@inherits ScissorHands.Plugin.PluginComponentBase

@if (Plugin is not null)
{
    <!-- Google tag (gtag.js) -->
    <script async src="@LoaderUrl"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    @* Already encoded for JavaScript string content; HTML encoding would change its meaning. *@
    gtag('config', '@((Microsoft.AspNetCore.Components.MarkupString)JavaScriptMeasurementId!)');
    </script>
}
