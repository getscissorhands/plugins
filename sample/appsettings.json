{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Site": {
    "Title": "ScissorHands plugin preview",
    "Description": "Inspect locally built plugins without publishing a NuGet package.",
    "Locale": "en-US",
    "Author": "ScissorHands contributors",
    "Theme": "default",
    "SiteUrl": "http://localhost:5000",
    "BaseUrl": "/",
    "HeroImage": "/images/sample.svg",
    "UseDateInPostUrl": false,
    "Debug": false
  },

  "Sample": {
    "UsePlaceholders": false
  },

  "Plugins": [
    {
      "Id": "open-graph",
      "Options": {
        "TwitterSiteId": "@example",
        "TwitterCreatorId": "@sample-author"
      }
    }
  ]
}
