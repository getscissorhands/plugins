{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Site": {
    "Title": "ScissorHands plugin preview",
    "Description": "Inspect locally built plugins without publishing a NuGet package.",
    "Locales": ["en-US", "ko-KR"],
    "Author": "ScissorHands contributors",
    "Theme": "default",
    "SiteUrl": "http://localhost:5000",
    "BaseUrl": "/",
    "UseDateInPostUrl": false,
    "TimeZone": "UTC",
    "Debug": false
  },

  "Theme": {
    "HeroImages": [
      { "Source": "/images/sample.svg", "Alt": "Sample site illustration" }
    ],
    "Localization": {
      "en-us": {
        "TranslationUnavailable": "This page is not available in English. Showing the original content.",
        "Draft": "Draft",
        "ScheduledOn": "Scheduled on {0}"
      },
      "ko-kr": {
        "TranslationUnavailable": "이 페이지는 한국어 번역이 없어 원문을 표시합니다.",
        "Draft": "초안",
        "ScheduledOn": "{0} 공개 예정"
      }
    }
  },

  "Plugins": [
    {
      "Id": "open-graph",
      "Options": {
        "TwitterSiteId": "@example",
        "TwitterCreatorId": "@sample-author"
      }
    },
    {
      "Id": "google-analytics",
      "Options": {
        "MeasurementId": "G-EXAMPLE"
      }
    }
  ]
}
